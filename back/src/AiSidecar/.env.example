# Copy this file to ".env" in the same folder as main.py and adjust values
# as needed. main.py loads it automatically at startup if "python-dotenv"
# is installed.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)

# --- Post-processing defaults for /segment (can be overridden per-request) ---
# SEGMENT_MORPH_RADIUS=2
# SEGMENT_MIN_BLOB_PCT=0.5

# --- Model overrides (rarely needed - defaults are the recommended models) ---
# INTERIOR_MODEL_ID=nvidia/segformer-b0-finetuned-ade-512-512
# EXTERIOR_SILHOUETTE_MODEL_ID=nvidia/segformer-b4-finetuned-ade-512-512
# EXTERIOR_DETAIL_MODEL_ID=Xpitfire/segformer-finetuned-segments-cmp-facade

# --- SAM (/regions endpoint) ---
# SAM_MODEL_ID=facebook/sam-vit-base
# SAM_POINTS_PER_BATCH=32
# SAM_PRED_IOU_THRESH=0.75
# SAM_STABILITY_SCORE_THRESH=0.85
