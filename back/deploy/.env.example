# =============================================================================
# Copy this file to deploy/.env and fill in real values before your first run:
#
#   cp deploy/.env.example deploy/.env
#
# Compose auto-loads deploy/.env because its default project directory is the directory of
# the (first) -f Compose file - here, deploy/ - not your current working directory. If you
# invoke Compose from somewhere else, or with -p/--project-directory pointed elsewhere, pass
# it explicitly instead: `docker compose -f deploy/docker-compose.yml --env-file deploy/.env ...`
#
# deploy/.env itself is gitignored - never commit real secrets to source control. This file
# (.env.example) is the committed template; keep it in sync with whatever variables
# deploy/docker-compose.yml actually reads, but never put a real secret in it.
# =============================================================================

# ---- Postgres --------------------------------------------------------------
POSTGRES_DB=imageseg
POSTGRES_USER=imageseg
POSTGRES_PASSWORD=imageseg

# ---- MinIO -------------------------------------------------------------
# Root credentials for the MinIO server itself. The backend authenticates to MinIO with these
# same values (Storage__MinIO__AccessKey/SecretKey in docker-compose.yml's x-web-env) - change
# them here and both sides update together, nowhere else to edit.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Host the *browser* must be able to reach for presigned URLs (spec §6) - not the in-cluster
# "minio:9000" address, which the browser cannot resolve. Must be https:// wherever the
# frontend itself is served over https, or the redirect is blocked as mixed content.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ---- CORS --------------------------------------------------------------
# Comma-separated, no spaces. Every origin the frontend is actually served from. Used both by
# the backend's own CORS middleware and (with "null" appended automatically for the
# redirect-to-MinIO case - see docker-compose.yml) by MinIO's server-wide CORS setting, so
# there is exactly one list to keep current as the frontend's deployment changes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Auth: JWT (required - no default, the app refuses to start without this) ----------
# Signs every access token the backend issues (spec §3). Generate a real one:
#   openssl rand -base64 48
# Must be at least 32 characters. Rotating this logs out every existing session instantly -
# there is no transition period, so treat it like any other credential rotation.
JWT_SIGNING_KEY=

# ---- Auth: Google OAuth (optional) --------------------------------------------------
# Leave both empty to run without Google sign-in - email/password auth works fine either way,
# and GET /api/auth/google/login cleanly 404s instead of crashing when these are unset. Set
# both to enable it; get them from Google Cloud Console (OAuth client, type "Web application"),
# with authorized redirect URI http://localhost:8080/api/auth/external-login-callback (adjust
# the host for non-local deployments).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI sidecar: Colab GPU backend for /regions (optional) --------------------------
# "Local" (default) uses the CPU SAM model baked into ai-sidecar - no further config needed.
# "Colab" routes POST /regions only (never Segment) to a GPU-backed Google Colab notebook
# reached over an ngrok tunnel - see the AI sidecar's own README for what that notebook needs
# to expose. The ngrok URL changes every time the notebook restarts; there is no automatic
# rediscovery, by design (spec §7) - update AI_SIDECAR_COLAB_BASE_URL here and
# `docker compose -f deploy/docker-compose.yml up -d web` each time it does.
AI_SIDECAR_REGIONS_BACKEND=Local
AI_SIDECAR_COLAB_BASE_URL=

# ---- Monitoring: Grafana admin login (optional) --------------------------------------
# Both default to admin/admin if left unset - fine for local dev, change before exposing
# Grafana anywhere reachable (see deploy/docker-compose.prod.yml for production, where
# GRAFANA_ADMIN_PASSWORD has no built-in default on purpose, same as JWT_SIGNING_KEY above).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
