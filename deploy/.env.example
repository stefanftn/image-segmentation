# =============================================================================
# Real values go in /home/moleraj/imageseg-secrets/.env on the VM - NOT inside this git
# checkout (see docker-compose.prod.yml's header for why: actions/checkout wipes untracked
# files on every self-hosted runner job). This file is only the committed template/reference.
# =============================================================================

# ---- Postgres --------------------------------------------------------------
POSTGRES_DB=imageseg
POSTGRES_USER=imageseg
POSTGRES_PASSWORD=

# ---- MinIO -------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Reached through root Nginx on its own subdomain (spec §6 - the browser fetches presigned
# URLs directly, not through the backend), never the internal container port or a path under
# moleraj.stefanpopovic.site - a presigned URL is its own origin from the browser's
# perspective, and wildcard TLS only covers one subdomain level (*.stefanpopovic.site does
# NOT cover storage.moleraj.stefanpopovic.site, only siblings like minio.stefanpopovic.site).
MINIO_PUBLIC_ENDPOINT=https://minio.stefanpopovic.site

# ---- CORS --------------------------------------------------------------
# The frontend's real origin. Comma-separated if ever more than one - here there's exactly
# one, since frontend and backend share moleraj.stefanpopovic.site (path-routed, so most
# frontend->backend calls are same-origin and never even trigger a CORS check - this only
# matters for the MinIO subdomain, a genuinely different origin).
CORS_ALLOWED_ORIGINS=https://moleraj.stefanpopovic.site

# ---- Auth: JWT (required - no default, the app refuses to start without this) ----------
# openssl rand -base64 48
JWT_SIGNING_KEY=

# ---- Auth: Google OAuth (optional) --------------------------------------------------
# Redirect URI to register in Google Cloud Console - GoogleDefaults.CallbackPath
# ("/signin-google"), a framework default the OAuth handler intercepts directly. This is what
# Google actually receives as redirect_uri; it is NOT /api/auth/external-login-callback (that
# path only comes into play after the framework's own callback handling finishes).
# https://moleraj.stefanpopovic.site/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI sidecar: Colab GPU backend for /regions (optional) --------------------------
AI_SIDECAR_REGIONS_BACKEND=Local
AI_SIDECAR_COLAB_BASE_URL=
