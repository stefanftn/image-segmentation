# Repo-wide - back/.gitignore and front/.gitignore (if any) cover their own subtrees, but a
# .gitignore file only ever applies to its own directory tree, so the root-level deploy/.env
# (production compose's secrets) needs its own rule here - back/.gitignore's ".env" line does
# NOT reach outside back/.
.env

bin/
obj/
*.user
.vs/
.idea/
*.DotSettings.user
